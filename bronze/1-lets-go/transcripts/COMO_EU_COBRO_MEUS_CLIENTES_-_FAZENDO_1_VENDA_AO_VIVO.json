		{
			"timestamps": {
				"from": "00:02:54,100",
				"to": "00:02:56,220"
			},
			"offsets": {
				"from": 174100,
				"to": 176220
			},
			"text": " Mas a maioria dos meus clientes é no PIX."
		},
		{
			"timestamps": {
				"from": "00:02:57,820",
				"to": "00:03:00,300"
			},
			"offsets": {
				"from": 177820,
				"to": 180300
			},
