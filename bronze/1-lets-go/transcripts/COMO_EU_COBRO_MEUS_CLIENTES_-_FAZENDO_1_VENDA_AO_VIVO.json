				"to": 114000
			},
			"text": " E aí você acha que dia que é melhor pra você."
		},
		{
			"timestamps": {
				"from": "00:01:54,460",
				"to": "00:01:55,320"
			},
			"offsets": {
				"from": 114460,
				"to": 115320
			},
			"text": " Amanhã eu tô um pouquinho corrido."
		},
		{
			"timestamps": {
				"from": "00:01:55,420",
				"to": "00:01:56,040"
			},
			"offsets": {
				"from": 115420,
				"to": 116040
			},
			"text": " Quinta, tô tranquilo."
		},
		{
			"timestamps": {
				"from": "00:01:56,100",
				"to": "00:01:56,440"
			},
			"offsets": {
				"from": 116100,
				"to": 116440
			},
			"text": " Que é feriado."
		},
		{
			"timestamps": {
				"from": "00:01:56,480",
				"to": "00:01:57,460"
			},
			"offsets": {
				"from": 116480,
				"to": 117460
			},
			"text": " Não sei se é bom pra você ou não."
