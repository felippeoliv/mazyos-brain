			"timestamps": {
				"from": "00:03:27,080",
				"to": "00:03:30,120"
			},
			"offsets": {
				"from": 207080,
				"to": 210120
			},
			"text": " Então, primeiro eu mostro ali o que eu vou implementar pra ele."
