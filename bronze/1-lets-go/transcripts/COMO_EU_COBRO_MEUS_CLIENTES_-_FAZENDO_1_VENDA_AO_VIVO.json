			"timestamps": {
				"from": "00:03:30,600",
				"to": "00:03:35,720"
			},
			"offsets": {
				"from": 210600,
				"to": 215720
			},
			"text": " E, novamente, eu dou a opção à vista e eu dou a opção parcelado."
