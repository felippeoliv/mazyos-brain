			"timestamps": {
				"from": "00:04:11,580",
				"to": "00:04:15,120"
			},
			"offsets": {
				"from": 251580,
				"to": 255120
			},
			"text": " Dentro aqui do meu banco, eu utilizo o Cora."
		},
		{
			"timestamps": {
				"from": "00:04:16,080",
				"to": "00:04:19,100"
			},
			"offsets": {
				"from": 256080,
				"to": 259100
			},
			"text": " Você pode utilizar o que você quiser pro seu CNPJ."
		},
		{
			"timestamps": {
				"from": "00:04:19,980",
				"to": "00:04:23,920"
			},
			"offsets": {
				"from": 259980,
				"to": 263920
			},
			"text": " Recomendo você ter um CNPJ, porque o CNPJ, eu tava até olhando aqui, ó."
		},
		{
			"timestamps": {
				"from": "00:04:23,920",
				"to": "00:04:28,200"
			},
			"offsets": {
				"from": 263920,
				"to": 268200
			},
			"text": " O CNPJ, ele traz mais confiança, mais credibilidade pra você."
