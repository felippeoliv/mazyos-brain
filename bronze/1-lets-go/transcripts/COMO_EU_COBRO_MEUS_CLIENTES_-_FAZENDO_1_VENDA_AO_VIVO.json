			"timestamps": {
				"from": "00:03:11,300",
				"to": "00:03:12,540"
			},
			"offsets": {
				"from": 191300,
				"to": 192540
			},
			"text": " Deixa eu abrir aqui, ó."
		},
		{
			"timestamps": {
				"from": "00:03:12,540",
				"to": "00:03:13,300"
			},
			"offsets": {
				"from": 192540,
				"to": 193300
			},
			"text": " Deixa eu abrir aqui, ó."
		},
