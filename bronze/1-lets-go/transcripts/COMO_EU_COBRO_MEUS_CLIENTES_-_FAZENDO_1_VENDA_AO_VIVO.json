				"to": "00:04:35,260"
			},
			"offsets": {
				"from": 268640,
				"to": 275260
			},
			"text": " Então, o cara abre um MEI, que seja, e abra uma conta no banco pra você receber seus Pix."
		},
		{
			"timestamps": {
				"from": "00:04:35,540",
				"to": "00:04:39,420"
			},
			"offsets": {
				"from": 275540,
				"to": 279420
			},
			"text": " Aqui, ó, eu mandei pro cara o Pix CNPJ."
		},
		{
			"timestamps": {
				"from": "00:04:40,140",
				"to": "00:04:42,160"
			},
			"offsets": {
				"from": 280140,
				"to": 282160
			},
			"text": " Isso daqui traz confiança pra ele."
		},
