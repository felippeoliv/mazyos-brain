				"to": "00:03:42,660"
			},
			"offsets": {
				"from": 219200,
				"to": 222660
			},
			"text": " Consegui conquistar várias coisas que muitas pessoas da minha idade ainda não conquistaram."
		},
		{
			"timestamps": {
				"from": "00:03:43,340",
				"to": "00:03:43,780"
			},
			"offsets": {
				"from": 223340,
				"to": 223780
			},
			"text": " E é isso."
		},
		{
			"timestamps": {
				"from": "00:03:43,960",
				"to": "00:03:44,860"
			},
			"offsets": {
				"from": 223960,
				"to": 224860
			},
			"text": " Recomendo você assistir."
		},
		{
			"timestamps": {
				"from": "00:03:45,440",
				"to": "00:03:46,020"
			},
			"offsets": {
				"from": 225440,
				"to": 226020
			},
